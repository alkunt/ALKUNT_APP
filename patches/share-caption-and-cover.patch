index 4376dbf..e6a40dd 100644
--- a/app/content-share.mjs
+++ b/app/content-share.mjs
@@ -23,6 +23,30 @@ export function contentShareData(product, language, origin) {
 const escapeHtml = value => String(value).replace(/[&<>"']/g, character =>
   ({'&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'}[character]));
 
+export function contentShareFileData(data, file) {
+  if (!file || file.type !== 'image/png' || !file.size) throw Error('A PNG cover is required.');
+  // File-share targets may ignore a separate URL member; keep it in the caption.
+  return {title:data.title, text:data.text, files:[file]};
+}
+
+export function canShareContentFile(data, file, navigator) {
+  if (typeof navigator?.share !== 'function' || typeof navigator?.canShare !== 'function') return false;
+  try { return navigator.canShare(contentShareFileData(data,file)) === true; }
+  catch { return false; }
+}
+
+export function shareContentFile(data, file, navigator) {
+  if (!canShareContentFile(data,file,navigator)) throw Error('File sharing unavailable.');
+  // Start during the click; the PNG is already prepared.
+  return navigator.share(contentShareFileData(data,file));
+}
+
+export async function copyContentShareText(data, clipboard) {
+  if (typeof clipboard?.writeText !== 'function') throw Error('Text copy unavailable.');
+  // Clipboard formats are alternatives, not a photo attachment with a caption.
+  await clipboard.writeText(data.text);
+}
+
 export function contentShareHtml(data, imageDataUrl) {
   if (!/^data:image\/png;base64,[a-z\d+/=]+$/i.test(imageDataUrl)) throw Error('A PNG cover is required.');
   const title = escapeHtml(data.title), url = escapeHtml(data.url);
