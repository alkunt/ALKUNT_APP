# Set to the exact public HTTPS origin, with no trailing slash.
APP_ORIGIN=https://your-domain.example
COOKIE_SECURE=true
DATA_DIR=./data
NEXT_TELEMETRY_DISABLED=1
# Required for emailed password recovery; also enables owner email notifications.
# MAIL_FROM must be a verified sending address in Resend.
RESEND_API_KEY=
MAIL_FROM=
# Generate NEW push keys with: node scripts/generate-push-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
